# Google Sign-In (OAuth 2.0 Web client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PostgreSQL — required for server-side auth, orders, partners
# Local: docker compose up -d  →  postgresql://jerib:jerib@localhost:5432/jerib
DATABASE_URL=

# Session signing secret (generate a long random string for production)
JWT_SECRET=

# Bank requisites shown to clients at checkout (update with your real details)
NEXT_PUBLIC_JIRIB_ALIF_ACCOUNT_NAME=JIRIB
NEXT_PUBLIC_JIRIB_ALIF_ACCOUNT=0000000000000000
NEXT_PUBLIC_JIRIB_ALIF_CARD=0000 0000 0000 0000
NEXT_PUBLIC_JIRIB_DCB_ACCOUNT_NAME=JIRIB
NEXT_PUBLIC_JIRIB_DCB_ACCOUNT=0000000000000000
NEXT_PUBLIC_JIRIB_DCB_CARD=0000 0000 0000 0000
